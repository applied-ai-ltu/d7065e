      "targets": [
        {
          "format": "time_series",
          "rawSql": "WITH hot AS (\n            SELECT DISTINCT room, level FROM fire_detection_sim.sensor_readings\n            WHERE sensor_type = 'smoke' AND value > 1.0\n            AND $__timeFilter(time) AND level IN (${floor:singlequote})\n        )\n        SELECT r.time, r.level || '/' || r.room AS metric, r.value\n        FROM fire_detection_sim.sensor_readings r\n        JOIN hot h ON r.room = h.room AND r.level = h.level\n        WHERE r.sensor_type = 'smoke' AND $__timeFilter(r.time)\n        ORDER BY r.time",
          "refId": "A"
        }
      ],
      "title": "Smoke \u2014 Top Rooms",
      "type": "timeseries"
