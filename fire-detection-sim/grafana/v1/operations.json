          "rawSql": "WITH fire_room AS (\n            SELECT room, level FROM fire_detection_sim.sensor_readings\n            WHERE sensor_type = 'smoke' AND $__timeFilter(time) AND level IN (${floor:singlequote})\n            GROUP BY room, level ORDER BY MAX(value) DESC LIMIT 1\n        )\n        SELECT r.time, r.sensor_type AS metric, r.value\n        FROM fire_detection_sim.sensor_readings r\n        JOIN fire_room f ON r.room = f.room AND r.level = f.level\n        WHERE $__timeFilter(r.time) ORDER BY r.time",
