          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT NOW() AS time, 'latency' AS metric, percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM time - t_alert))::float AS value FROM ( SELECT o.time, o.room, o.override_type, (SELECT MAX(a.time) FROM fire_detection_sim.edge_decisions a WHERE a.kind = 'alert' AND a.room = o.room AND a.time BETWEEN o.time - INTERVAL '120 seconds' AND o.time) AS t_alert FROM fire_detection_sim.llm_overrides o WHERE o.override_type IN ('confirm','watch_pending') AND $__timeFilter(o.time)) v WHERE t_alert IS NOT NULL"
        }
      ],
      "fieldConfig": {
