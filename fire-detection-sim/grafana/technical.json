    {
      "id": 28,
      "type": "bargauge",
      "title": "Tier-2 verdict on edge alerts",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TIMESCALE"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TIMESCALE"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH a AS ( SELECT time, room FROM fire_detection_sim.edge_decisions WHERE kind = 'alert' AND severity IN ('warning','confirmed','critical') AND $__timeFilter(time)), v AS ( SELECT (SELECT o.override_type FROM fire_detection_sim.llm_overrides o WHERE o.room = a.room AND o.time BETWEEN a.time AND a.time + INTERVAL '60 seconds' ORDER BY o.time LIMIT 1) AS llm FROM a) SELECT NOW() AS time, CASE WHEN llm = 'confirm' THEN 'LLM confirmed' WHEN llm = 'watch_pending' THEN 'LLM doubted' ELSE 'not re-assessed (dedupe)' END AS metric, COUNT(*)::float AS value FROM v GROUP BY 2 ORDER BY 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto"
      },
      "description": "What Tier 2 made of each Tier-1 alert"
    },
