    {
      "id": 7,
      "type": "table",
      "title": "Edge controllers",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TIMESCALE"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TIMESCALE"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT level, role, node, EXTRACT(EPOCH FROM NOW() - MAX(time)) < 30 AS alive, BOOL_OR(acting) FILTER (WHERE time > NOW() - INTERVAL '30 seconds') AS acting, MAX(time) AS last_seen FROM fire_detection_sim.heartbeats WHERE time > NOW() - INTERVAL '1 hour' GROUP BY level, role, node ORDER BY level, role"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alive"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "alive",
                        "color": "green",
                        "index": 0
                      },
                      "false": {
                        "text": "SILENT",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "acting"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "ACTING",
                        "color": "green",
                        "index": 0
                      },
                      "false": {
                        "text": "standby",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Active on the Raspberry Pi, standby on the amd64 node. A standby promotes after 30 s of silence."
