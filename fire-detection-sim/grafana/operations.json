    {
      "id": 9,
      "type": "state-timeline",
      "title": "Incident timeline (Tier-2 verdict per room)",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "DS_TIMESCALE"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "DS_TIMESCALE"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, level || '/' || room AS metric, CASE override_type WHEN 'stand_down' THEN 1 WHEN 'watch_pending' THEN 2 WHEN 'stand_down_refused' THEN 3 WHEN 'confirm' THEN 4 WHEN 'escalated' THEN 5 END::float AS value FROM fire_detection_sim.llm_overrides WHERE $__timeFilter(time) AND room NOT LIKE '\\_%' AND level IN (${floor:singlequote}) AND override_type IN ('confirm','escalated','stand_down_refused','watch_pending','stand_down') ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1.5,
                "result": {
                  "text": "stood down",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1.5,
                "to": 2.5,
                "result": {
                  "text": "watching",
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2.5,
                "to": 3.5,
                "result": {
                  "text": "stand-down refused",
                  "color": "purple",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 3.5,
                "to": 4.5,
                "result": {
                  "text": "confirmed",
                  "color": "red",
                  "index": 3
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 4.5,
                "to": 5.5,
                "result": {
                  "text": "escalated",
                  "color": "dark-red",
                  "index": 4
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "Escalate immediately, de-escalate only on 60 s of clear readings"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Smoke \u2014 rooms flagged by Tier 1",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
