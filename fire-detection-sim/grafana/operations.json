          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH hot AS ( SELECT DISTINCT room, level FROM fire_detection_sim.edge_decisions WHERE $__timeFilter(time) AND room NOT LIKE '\\_%' AND level IN (${floor:singlequote})) SELECT time_bucket('10 seconds', r.time) AS time, r.level || '/' || r.room AS metric, AVG(r.value)::float AS value FROM fire_detection_sim.sensor_readings r JOIN hot USING (room, level) WHERE r.sensor_type = 'temperature' AND $__timeFilter(r.time) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
