shape: sequence_diagram

classes: {
  hb: {style: {stroke: "#8a8a8a"; stroke-dash: 3; font-size: 18; font-color: "#666"}}
  alert: {style: {stroke: "#c0392b"; font-color: "#c0392b"; font-size: 18}}
  cmd: {style: {stroke: "#2a7f62"; font-color: "#2a7f62"; font-size: 18}}
  rest: {style: {stroke: "#1f5fbf"; font-color: "#1f5fbf"; font-size: 18}}
  note: {style: {font-size: 17; fill: "#fff6e0"; stroke: "#7a4b00"}}
  actor: {style: {font-size: 20}}
}

buildsim: "BuildSim" {class: actor}
active: "edge level1 active\n(Pi)" {class: actor}
server: "fds-server" {class: actor}
standby: "edge level1 standby\n(amd64 node)" {class: actor}

active -> buildsim: "\nPUT 46 doors closed_unlocked  (own fire confirmed)" {class: rest}
active -> server: "\nalert A209, severity = confirmed" {class: alert}
server."confirmed: level0 and level2 doors released (cross-floor)" {class: note}
active."heartbeat to the standby every 10 s" {class: note}
active."pod deleted (kubectl delete pod)" {class: note}
standby."30 s without the active's heartbeat → PROMOTED (acting = true)" {class: note}
standby -> server: "\nalert: decision = failover" {class: alert}
standby."keeps ticking on the same readings;\ndoors untouched (never re-locked by a handover)" {class: note}
active."Deployment recreates the pod (21 s); empty state; heartbeat resumes" {class: note}
standby."DEMOTED (acting = false), 5 s after promotion" {class: note}
server -> active: "\nstand-down: floor_clear = true, relock = true" {class: cmd}
active -> buildsim: "\nPUT 46 doors closed_locked  (relock covers the lost state)" {class: rest}
server -> active: "\nALL CLEAR: doors: lock (every floor)" {class: cmd}