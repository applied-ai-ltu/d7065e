grid-rows: 4
grid-gap: 70

classes: {
  tier: {style: {stroke-width: 2; border-radius: 8; font-size: 16; bold: true}}
  host: {style: {border-radius: 6; stroke: "#555"; fill: "#ffffff"; font-size: 13}}
  pod: {style: {border-radius: 4; stroke: "#1f5fbf"; fill: "#f5f9ff"; font-size: 12}}
  infra: {style: {border-radius: 6; stroke: "#8a8a8a"; fill: "#f4f4f4"; stroke-dash: 3; font-size: 13}}
  mqtt: {style: {stroke: "#2a7f62"; font-size: 12; font-color: "#2a7f62"; stroke-width: 2}}
  alert: {style: {stroke: "#c0392b"; font-size: 12; font-color: "#c0392b"; stroke-width: 2}}
  rest: {style: {stroke: "#1f5fbf"; font-size: 12; font-color: "#1f5fbf"}}
  data: {style: {stroke: "#6c3fb5"; font-size: 12; font-color: "#6c3fb5"; stroke-dash: 3}}
}

tier1: "TIER 1 — edge controllers, one per floor" {
  class: tier
  style.fill: "#e8f1fb"
  grid-columns: 3
  grid-gap: 30
  pi: "pi400-master-01 · Raspberry Pi 400 (ARM64) · actives" {
    class: host
    grid-columns: 3
    e0: "edge-level0-active" {class: pod}
    e1: "edge-level1-active" {class: pod}
    e2: "edge-level2-active" {class: pod}
  }
  im: "infinity-magic · amd64 · standbys (same image and spec)" {
    class: host
    grid-columns: 3
    s0: "edge-level0-standby" {class: pod}
    s1: "edge-level1-standby" {class: pod}
    s2: "edge-level2-standby" {class: pod}
  }
  note: "Per floor, every 5 s: threshold rule + isolation forest\n(ONNX, p50 18 ms on the Pi). Releases its own floor's doors\nin the same tick. Heartbeat every 10 s; the standby promotes\nafter 30 s of silence. Works without server, broker or LLM." {
    style.font-size: 12
    style.stroke: transparent
    style.fill: transparent
  }
}

mqrow: "" {
  style.stroke: transparent
  style.fill: transparent
  grid-columns: 3
  grid-gap: 60
  topics_up: |md
    **edge → server** (red)
    alerts/‹floor›/‹room› · decisions/‹floor›/‹room› · heartbeat/‹floor›/‹role›
  | {style.font-size: 12}
  mq: "mosquitto — MQTT broker (ns data-infra)" {
    class: infra
    style.fill: "#eef7ea"
    style.stroke: "#2a7f62"
    style.stroke-dash: 0
    style.font-size: 14
  }
  topics_down: |md
    **server → edge** (green)
    building/‹floor›/‹room›/‹sensor› (readings) · commands/‹floor›/doors · commands/‹floor›/stand-down
  | {style.font-size: 12}
}

tier2: "TIER 2 — fds-server (proart-master-01, NodePort 30089)" {
  class: tier
  style.fill: "#fdf1e4"
  grid-columns: 4
  grid-gap: 30
  physics: "physics engine + sensor gateway\n956 spaces · spread along door graph\n· sensor faults (noise, drift, stuck)" {class: pod}
  agent: "agent\nalert queue (3 parallel) → LLM verdict\n→ coordinate floors → watch /\nstand-down → ALL CLEAR" {class: pod}
  pipeline: "pipeline\nMQTT → TimescaleDB" {class: pod}
  api: "control API\nfire · false alarm\nviz/clear · status" {class: pod}
}

ext: "" {
  style.stroke: transparent
  style.fill: transparent
  grid-columns: 4
  grid-gap: 30
  buildsim: "BuildSim (NodePort 30909)\n3D viewer · 124 fire doors\nsprinklers · floor graph" {class: infra; style.fill: "#ffffff"}
  llm: "LiteLLM → SGLang\nQwen2.5-14B (ns ai-inference, GPU)\nverdict p50 2.1 s · p95 3.2 s" {class: infra}
  db: "TimescaleDB (ns data-infra)\nsensor_readings 18 GB · edge_decisions\nheartbeats · llm_overrides" {class: infra}
  obs: "Grafana (30300) · Phoenix · ClearML\nretrain → detector.onnx → deploy.sh edge" {class: infra}
}

tier1.pi -> mqrow.mq: {class: alert}
mqrow.mq -> tier1.im: {class: mqtt}
tier2.physics -> mqrow.mq: {class: mqtt}
mqrow.mq -> tier2.agent: {class: alert}
mqrow.mq -> tier2.pipeline: {class: mqtt}

tier2.agent -> ext.buildsim: "effects · cards\ndoors of a taken-over floor" {class: rest}
ext.buildsim -> tier2.physics: "floor plans\ndoor graph" {class: rest; style.stroke-dash: 3}
tier2.agent -> ext.llm: {class: data; style.stroke-dash: 0}
tier2.pipeline -> ext.db {class: data}
ext.db -> ext.obs {class: data}
tier1.pi -> ext.buildsim: "PUT door state (own floor)" {class: rest}
