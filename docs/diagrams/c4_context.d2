direction: down

title: {
  label: "C4 System Context (Level 1) — Fire Detection & Autonomous Response at the Edge"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

classes: {
  person: {shape: person; style: {fill: "#08427b"; font-size: 13}}
  system: {style: {fill: "#1168bd"; font-color: "#ffffff"; border-radius: 8; font-size: 14; bold: true}}
  ext: {style: {fill: "#999999"; font-color: "#ffffff"; border-radius: 8; font-size: 13}}
  rel: {style: {font-size: 12}}
}

operator: "Building operator\nwatches viewer and dashboards,\ntriggers test fires and false alarms" {class: person}

fire_system: "Fire Detection & Autonomous Response\n[Software System]\nTier 1: edge controllers per floor (Raspberry Pi) detect and release doors locally.\nTier 2: server agent confirms with an LLM, coordinates floors, stands the building down." {class: system}

llm: "LLM inference service\n[Software System]\nLiteLLM → SGLang, Qwen2.5-14B,\nself-hosted on the cluster GPU" {class: ext}
buildsim: "BuildSim\n[Software System]\nBuilding model of LTU A-huset: 950 rooms,\n124 fire doors, sprinklers, 3D viewer" {class: ext}
observability: "Observability\n[Software Systems]\nGrafana dashboards, Phoenix LLM traces,\nClearML training runs, TimescaleDB" {class: ext}

operator -> fire_system: "starts/stops fires, triggers false alarms,\nclears the viewer  [REST control API]" {class: rel}
operator -> buildsim: "watches doors, effects, alert cards\n[3D viewer]" {class: rel}
operator -> observability: "monitors incidents, latencies,\ncontroller health  [Grafana]" {class: rel}
fire_system -> llm: "asks for a verdict on each alert\n{is_fire, confidence}  [HTTP, ~2 s]" {class: rel}
fire_system -> buildsim: "reads floor plans, door graph, equipment;\ncommands doors; pushes effects and cards  [REST]" {class: rel}
fire_system -> observability: "readings, decisions, verdicts, heartbeats\n[MQTT → TimescaleDB]" {class: rel}