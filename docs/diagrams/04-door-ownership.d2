direction: down

classes: {
  locked: {style: {border-radius: 20; stroke: "#2a7f62"; fill: "#eef7ea"; font-size: 20; bold: true; stroke-width: 2}}
  released: {style: {border-radius: 20; stroke: "#c0392b"; fill: "#fdeeec"; font-size: 20; bold: true; stroke-width: 2}}
  edge: {style: {stroke: "#1f5fbf"; font-color: "#1f5fbf"; font-size: 17; stroke-width: 2}}
  server: {style: {stroke: "#6c3fb5"; font-color: "#6c3fb5"; font-size: 17; stroke-width: 2}}
  guard: {style: {stroke: "#555"; font-color: "#555"; font-size: 17; stroke-dash: 3}}
}

locked: "LOCKED\n(closed_locked, normal state)" {class: locked}
own: "RELEASED — own release\nthis floor's controller\nconfirmed a fire here\n(own_release = true)" {class: released}
srv: "RELEASED — server release\nfire on another floor;\nserver commanded release\n(server_release = true)" {class: released}
both: "RELEASED — both\nown fire and cross-floor\nrelease active" {class: released}

locked -> own: "edge: FIRE on this floor\n(same tick, no server)" {class: edge}
locked -> srv: "server: doors release\n(cross-floor)" {class: server}
own -> both: "server: cross-floor\nrelease arrives" {class: server}
srv -> both: "edge: own fire\nconfirmed" {class: edge}
own -> locked: "server: stand-down,\nfloor_clear = true\n(edge: no room critical)" {class: server}
srv -> locked: "server: ALL CLEAR\ndoors lock" {class: server}
both -> srv: "stand-down, floor_clear\n→ own release cleared,\ndoors stay open" {class: guard}
both -> own: "ALL CLEAR lock\n→ ignored while own\nfire is confirmed" {class: guard}