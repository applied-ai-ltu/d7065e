direction: right

title: {
  label: "Deployment Diagram — Fire Detection System on K3s Cluster"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

proart: {
  label: "ProArt Server (Control Plane + GPU)\nRyzen 9 9950X, 128GB RAM, RTX 5060 Ti 16GB"
  style.fill: "#e8f4fd"
  style.border-radius: 8

  core: {
    label: "Core Detection Loop (edge-critical)"
    style.fill: "#d4edda"
    style.border-radius: 8

    physics: "Physical Simulator\n[Python]" {style.fill: "#438dd5"; style.font-color: "#fff"}
    gateway: "Sensor Gateway\n[Python]" {style.fill: "#438dd5"; style.font-color: "#fff"}
    mqtt: "Mosquitto\n[MQTT :31174]" {style.fill: "#438dd5"; style.font-color: "#fff"}
    pipeline: "Pipeline Consumer\n[Python]" {style.fill: "#438dd5"; style.font-color: "#fff"}
    tsdb: "TimescaleDB\n[:30543]" {style.fill: "#438dd5"; style.font-color: "#fff"; shape: cylinder}
    agent: "Fire Agent\n[Python]" {style.fill: "#438dd5"; style.font-color: "#fff"}
    control: "Control API\n[FastAPI :8089]" {style.fill: "#438dd5"; style.font-color: "#fff"}
  }

  intelligence: {
    label: "AI / Intelligence (GPU)"
    style.fill: "#fff3cd"
    style.border-radius: 8

    litellm: "LiteLLM\n[HTTPS :30400]" {style.fill: "#e67e22"; style.font-color: "#fff"}
    ollama: "Ollama\n[Qwen 2.5 14B\n+ gemma4:12b]" {style.fill: "#e67e22"; style.font-color: "#fff"}
  }

  monitoring: {
    label: "Monitoring & MLOps"
    style.fill: "#f8d7da"
    style.border-radius: 8

    grafana: "Grafana\n[:30300]" {style.fill: "#dc3545"; style.font-color: "#fff"}
    phoenix: "Phoenix\n[:30600]" {style.fill: "#dc3545"; style.font-color: "#fff"}
    clearml: "ClearML\n[:30808]" {style.fill: "#dc3545"; style.font-color: "#fff"}
  }

  infra: {
    label: "Infrastructure"
    style.fill: "#e2e3e5"
    style.border-radius: 8

    buildsim: "BuildSim\n[:30909]" {style.fill: "#6c757d"; style.font-color: "#fff"}
    vault: "Vault\n[:30820]" {style.fill: "#6c757d"; style.font-color: "#fff"}
    argocd: "ArgoCD\n[:30444]" {style.fill: "#6c757d"; style.font-color: "#fff"}
  }
}

pi: {
  label: "Raspberry Pi 400 (Edge Node)\nARM aarch64, 4GB RAM"
  style.fill: "#e8f4fd"
  style.border-radius: 8

  onnx: "ONNX Detector\n[onnxruntime]\n1,695 KB model" {style.fill: "#28a745"; style.font-color: "#fff"}
}

jetson: {
  label: "Jetson Orin Nano\nARM + GPU"
  style.fill: "#e8f4fd"
  style.border-radius: 8

  embedding: "Ollama\n[qwen3-embedding:4b]" {style.fill: "#e67e22"; style.font-color: "#fff"}
}

# Network connections
proart.core.agent -> proart.intelligence.litellm: "LLM calls\n[HTTPS]"
proart.core.gateway -> proart.core.mqtt: "MQTT"
proart.core.mqtt -> proart.core.pipeline: "MQTT"
proart.core.pipeline -> proart.core.tsdb: "SQL"
proart.monitoring.grafana -> proart.core.tsdb: "SQL"
proart.core.physics -> proart.infra.buildsim: "REST"
proart.core.agent -> proart.infra.buildsim: "REST"

proart -> pi: "Ethernet 1 Gbps" {style.stroke-dash: 3}
proart -> jetson: "Ethernet 1 Gbps" {style.stroke-dash: 3}
