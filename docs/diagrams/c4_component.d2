direction: right

title: {
  label: "C4 Component Diagram (Level 3) — Inside the Fire Agent"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

# External
tsdb: {
  label: "TimescaleDB"
  style.fill: "#999999"
  style.font-color: "#ffffff"
  shape: cylinder
}

buildsim: {
  label: "BuildSim"
  style.fill: "#999999"
  style.font-color: "#ffffff"
  style.border-radius: 8
}

litellm: {
  label: "LiteLLM"
  style.fill: "#999999"
  style.font-color: "#ffffff"
  style.border-radius: 8
}

# Agent container
agent: {
  label: "Fire Agent [Container: Python]"
  style.stroke-dash: 3
  style.fill: "#ffffff"

  poller: {
    label: "Sensor Poller\n[Component]\nBatch-reads equipment\nlist from BuildSim"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  detector: {
    label: "Anomaly Detector\n[Component: sklearn]\nIsolation forest\non 6 features"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  threshold: {
    label: "Threshold Filter\n[Component]\nsmoke>2, co>5, temp>25\nAvoids LLM noise calls"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  spread: {
    label: "Spread Predictor\n[Component]\nSpatial proximity +\ntemperature boost"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  evacuation: {
    label: "Evacuation Planner\n[Component]\nDijkstra with\nblocked rooms"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  planner: {
    label: "LLM Planner\n[Component]\nAssess + plan\nvia LiteLLM"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  verifier: {
    label: "Safety Verifier\n[Component]\nAll exits unlocked?\nSprinkler in fire room?"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  commander: {
    label: "Actuator Commander\n[Component]\nIssues REST commands\nto BuildSim"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  logger: {
    label: "Event Logger\n[Component]\nWrites fire_events\nto TimescaleDB"
    style.fill: "#85bbf0"
    style.border-radius: 8
  }

  fallback: {
    label: "Rule-based Fallback\n[Component]\nActivates when\nLLM unavailable"
    style.fill: "#f0c585"
    style.border-radius: 8
  }

  # Internal flow
  poller -> detector: "readings"
  detector -> threshold: "anomalies"
  threshold -> spread: "confirmed"
  threshold -> evacuation: "confirmed"
  spread -> planner: "risk rooms"
  evacuation -> planner: "routes"
  planner -> verifier: "proposed plan"
  verifier -> commander: "approved plan"
  commander -> logger: "executed"
  planner -> fallback: "LLM fails" {style.stroke-dash: 3}
  fallback -> commander: "rule-based plan" {style.stroke-dash: 3}
}

# External connections
buildsim -> agent.poller: "GET /equipment\n[REST]"
agent.commander -> buildsim: "PUT /actuators\n[REST]"
agent.planner -> litellm: "assessment\n[HTTPS]"
agent.logger -> tsdb: "INSERT fire_events\n[SQL]"
